# Dependencies
node_modules/

# Turborepo cache
.turbo/

# Environment variables (secrets - never commit)
.env
.env.local
.env.*.local

# Build outputs
dist/
build/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# OS & Editor files
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/


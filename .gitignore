apps/backend/uploads/residents/*
!apps/backend/uploads/residents/.gitkeep

apps/backend/uploads/admins/*
!apps/backend/uploads/admins/.gitkeep

apps/backend/uploads/admin-ids/*
!apps/backend/uploads/admin-ids/.gitkeep

apps/backend/uploads/resident-ids/*
!apps/backend/uploads/resident-ids/.gitkeep

apps/backend/uploads/complaint-evidence/*
!apps/backend/uploads/complaint-evidence/.gitkeep

apps/backend/uploads/announcements/*
!apps/backend/uploads/announcements/.gitkeep

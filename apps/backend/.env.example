DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
JWT_SECRET=replace-with-a-long-random-secret
PORT=4000

# Gmail SMTP configuration (for email verification and notification emails).
# Use a Google App Password, never your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-sending-account@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM=Barangay Poblacion <your-sending-account@gmail.com>

# Frontend URLs for redirect/verification links
FRONTEND_URL=http://localhost:5173
RESIDENT_FRONTEND_URL=http://localhost:5500

# Cloudinary configuration (optional but recommended for production uploads)
# Sign up at https://cloudinary.com and copy your cloud credentials.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

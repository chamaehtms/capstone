DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
JWT_SECRET=replace-with-a-long-random-secret
PORT=4000

# Resend email delivery for verification, password reset, and notifications.
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM=Barangay Poblacion <onboarding@resend.dev>

# Frontend URLs for redirect/verification links
FRONTEND_URL=http://localhost:5173
RESIDENT_FRONTEND_URL=http://localhost:5500

# Cloudinary configuration (optional but recommended for production uploads)
# Sign up at https://cloudinary.com and copy your cloud credentials.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

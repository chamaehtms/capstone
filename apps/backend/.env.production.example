# ========================================================
# Production Environment Variables Example
# Copy or set these in your hosting provider's dashboard
# (Render, Railway, Fly.io, Heroku, etc.)
# ========================================================

NODE_ENV=production
PORT=4000

# PostgreSQL Connection String (e.g. Neon, Supabase, Render PostgreSQL)
# Must include sslmode=require if using cloud-hosted databases
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Secret key for signing JWT tokens (generate a long, 32+ character random string)
JWT_SECRET=generate-a-strong-random-32-character-secret-key

# Additional allowed origins for CORS (comma-separated)
CORS_ORIGIN=https://admin.yourdomain.com,https://brgy-poblacion.site

# Frontend URLs for redirect/verification links sent in emails
FRONTEND_URL=https://admin.yourdomain.com
RESIDENT_FRONTEND_URL=https://resident.yourdomain.com

# Resend API for verification, password reset, and notifications; use a verified sender domain.
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM=Barangay Poblacion <no-reply@yourdomain.com>

# Cloudinary configuration for media uploads in production
# Create a Cloudinary account and add your cloud credentials here.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
